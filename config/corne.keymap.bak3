#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// German keycode definitions
#define DE_Y Z
#define DE_Z Y
#define DE_SS MINUS
#define DE_UE LBKT
#define DE_OE SEMI
#define DE_AE SQT

/ {
        behaviors {
                hml: homerow_mods_left {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_LEFT";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <175>;
                        quick-tap-ms = <125>;
                        require-prior-idle-ms = <125>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
                };

                hmr: homerow_mods_right {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_RIGHT";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <175>;
                        quick-tap-ms = <125>;
                        require-prior-idle-ms = <125>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// | DEL  |  K  |  .  |  O  |  ,  |  Y  |   |  V  |  G  |  C  |  L  |  ß  |  Z   |
// | ESC  | H/⇧ | A/⌃ | E/⌥ | I/⌘ |  U  |   |  D  | T/⌘ | R/⌥ | N/⌃ | S/⇧ |  F   |
// | TAB  |  X  |  Q  |  Ä  |  Ü  |  Ö  |   |  B  |  P  |  W  |  M  |  J  |  MO4 |
//                    | LWR |SPC/S|BSPC |   | TAB |ENT/S| NUM |
                        display-name = "Base";
                        bindings = <
   &kp DEL    &kp K         &kp DOT       &kp O         &kp COMMA     &kp DE_Y       &kp V  &kp G         &kp C         &kp L         &kp DE_SS     &kp DE_Z
   &kp ESC    &hml LSHFT H  &hml LCTRL A  &hml LALT E   &hml LGUI I   &kp U          &kp D  &hmr RGUI T   &hmr RALT R   &hmr RCTRL N  &hmr RSHFT S  &kp F
   &kp TAB    &kp X         &kp Q         &kp DE_AE     &kp DE_UE     &kp DE_OE      &kp B  &kp P         &kp W         &kp M         &kp J         &mo 4
                                          &mo 3         &lt 1 SPACE   &kp BSPC       &kp TAB &lt 1 RET    &mo 2
                        >;
                };

                symbols_layer {
// -----------------------------------------------------------------------------------------
// |      |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  /  |  ?  |  `   |
// |  "   |  <  |  (  |  {  |  [  |  \  |   |  |  |  ]  |  }  |  )  |  >  |  '   |
// |  ´   |  €  |  ~  |  =  |  +  |  -  |   |  _  |  :  |  ;  |  ,  |  .  |  °   |
//                    |     | ___ |     |   |     | ___ |     |
                        display-name = "Symb";
                        bindings = <
   &trans        &kp LS(N1)    &kp RA(Q)     &kp BSLH      &kp LS(N4)    &kp LS(N5)         &kp GRAVE     &kp LS(N6)    &kp LS(RBKT)  &kp LS(N7)    &kp LS(MINUS) &kp LS(EQUAL)
   &kp LS(N2)    &kp NUBS      &kp LS(N8)    &kp RA(N7)    &kp RA(N8)    &kp RA(MINUS)      &kp RA(NUBS)  &kp RA(N9)    &kp RA(N0)    &kp LS(N9)    &kp LS(NUBS)  &kp LS(BSLH)
   &kp EQUAL     &kp RA(E)     &kp RA(RBKT)  &kp LS(N0)    &kp RBKT      &kp SLASH          &kp LS(SLASH) &kp LS(DOT)   &kp LS(COMMA) &kp COMMA     &kp DOT       &kp LS(GRAVE)
                                             &trans        &trans        &trans             &trans        &trans        &trans
                        >;
                };

                numbers_layer {
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |  /  |  7  |  8  |  9  |  -  |      |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |  *  |  4  |  5  |  6  |  +  |      |
// |      |     |     |     |QWERT|     |   |  =  |  1  |  2  |  3  |  .  |      |
//                    |     |     |     |   |     |  0  |     |
                        display-name = "Numb";
                        bindings = <
   &trans        &trans        &trans        &trans        &trans        &trans             &kp LS(N7)    &kp N7        &kp N8        &kp N9        &kp SLASH      &trans
   &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4       &kp LS(RBKT)  &kp N4        &kp N5        &kp N6        &kp RBKT       &trans
   &trans        &trans        &trans        &trans        &trans        &to 5              &kp LS(N0)    &kp N1        &kp N2        &kp N3        &kp DOT        &trans
                                             &trans        &trans        &trans             &trans        &kp N0        &trans
                        >;
                };

                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB | ⌘+X | ⌘+A | ⌘+C | ⌘+V | ⌘+Z |   |  :  |  /  |  8  |  9  |  0  | BKSP |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   | PREV| PLAY| NEXT| MUTE| V- | V+   |
//                    | ___ |     |     |   |     |     |     |
                        display-name = "Lower";
                        bindings = <
   &kp TAB    &kp LG(X)    &kp LG(A)    &kp LG(C)    &kp LG(V)    &kp LG(Z)      &kp LS(DOT) &kp LS(N7)  &kp N8      &kp N9       &kp N0        &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT    &trans        &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_MUTE   &kp C_VOL_DN  &kp C_VOL_UP
                          	        &trans       &trans       &trans         &trans      &trans      &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |      |     | Layo| Rsz+| Rsz-|     |   | F1  | F2  | F3  | F4  | F5  | F6   |
// |      |     | WS1 | Foc↓| Foc↑| Foc→|   | F7  | F8  | F9  | F10 | F11 | F12  |
// |      |     | MvL | Mv↓ | Mv↑ | Mv→ |   | SS  | BRI-| BRI+|     |     | ___ |
//                    |     |     |     |   |     |     |     |
                        display-name = "Raise";
                        bindings = <
   &trans            &trans            &kp LC(LA(LS(I))) &kp LC(LA(LS(A))) &kp LC(LA(LS(H))) &trans             &kp F1         &kp F2       &kp F3       &kp F4       &kp F5       &kp F6
   &trans            &trans            &kp LC(LA(LS(D))) &kp LC(LA(LS(T))) &kp LC(LA(LS(R))) &kp LC(LA(LS(N))) &kp F7         &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
   &trans            &trans            &kp LC(LA(LS(V))) &kp LC(LA(LS(G))) &kp LC(LA(LS(C))) &kp LC(LA(LS(L))) &kp LG(LS(N4)) &kp C_BRI_DN &kp C_BRI_UP &trans       &trans       &trans
                                                          &kp LGUI          &trans            &kp SPACE          &kp RET        &trans       &kp RALT
                        >;
                };

                QWERTZ {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Z  |  U  |  I  |  O  |  P  |  Ü   |
// |  ESC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  Ö  |  Ä   |
// | SHFT |  Y  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  -  | ___ |
//                    | CTRL| SPC | BSPC|   | RET | SPC | ALT |
                        display-name = "QWERTZ";
                        bindings = <
   &kp TAB    &kp Q  &kp W  &kp E     &kp R     &kp T          &kp DE_Z   &kp U  &kp I      &kp O    &kp P      &kp DE_UE
   &kp ESC    &kp A  &kp S  &kp D     &kp F     &kp G          &kp H      &kp J  &kp K      &kp L    &kp DE_OE  &kp DE_AE
   &kp LSHFT  &kp DE_Y &kp X &kp C    &kp V     &kp B          &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH  &trans
                            &kp LCTRL &kp SPACE &kp BSPC       &kp RET    &kp SPACE &kp RALT
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };
        };
};
