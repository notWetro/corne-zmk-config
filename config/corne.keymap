#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// German keycode definitions
#define DE_Y Y
#define DE_Z Z
#define DE_SS MINUS
#define DE_UE LBKT
#define DE_OE SEMI
#define DE_AE SQT

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
   &kp DEL       &kp K         &kp DOT       &kp O          &kp COMMA      &kp DE_Y        &kp V      &kp G          &kp C          &kp L          &kp DE_SS      &kp DE_Z
   &kp ESC       &hml LSHFT H  &hml LCTRL A  &hml LALT E    &hml LGUI I    &kp U           &kp D      &hmr RGUI T    &hmr RALT R    &hmr RCTRL N   &hmr RSHFT S   &kp F
   &kp TAB       &kp X         &kp Q         &kp DE_AE      &kp DE_UE      &kp DE_OE       &kp B      &kp P          &kp W          &kp M          &kp J          &mo 6
                                             &tog 1         &kp LC(LS(LALT)) &lt 2 SPACE   &lt 4 TAB  &lt 2 RET      &tog 1
            >;
        };

        layer_1 {
            bindings = <
   &trans        &trans        &trans        &trans         &trans         &trans          &trans     &trans         &trans         &trans         &trans         &trans
   &trans        &trans        &hml LGUI A   &trans         &hml LCTRL I   &trans          &trans     &hmr RCTRL T   &trans         &hmr RGUI N    &trans         &trans
   &kp TAB       &kp X         &kp Q         &kp DE_AE      &kp DE_UE      &trans          &trans     &trans         &trans         &trans         &trans         &trans
                                             &trans         &trans         &lt 3 SPACE     &trans     &lt 3 RET      &trans
            >;
        };

        layer_2 {
            bindings = <
   &kp ESC       &kp LS(N1)    &kp LA(L)     &kp LA(N8)     &kp LA(N9)     &kp LA(LS(N7))  &kp LS(RBKT)  &kp N7      &kp N8         &kp N9         &kp LS(SLASH)  &kp LS(EQUAL)
   &kp LS(N2)    &kp BSLH      &kp LS(N4)    &kp LS(N8)     &kp LS(N9)     &kp LS(N7)      &kp LS(N0)    &kp N4      &kp N5         &kp N6         &kp RBKT       &kp LS(BSLH)
   &trans        &kp LS(N5)    &kp LS(N6)    &kp LA(N5)     &kp LA(N6)     &kp LA(N7)      &kp N0        &kp N1      &kp N2         &kp N3         &kp SLASH      &kp EQUAL
                                             &kp GRAVE      &kp LS(GRAVE)  &trans          &trans        &trans      &kp RA(E)
            >;
        };

        layer_3 {
            bindings = <
   &kp ESC       &kp LS(N1)    &kp RA(Q)     &kp RA(N7)     &kp RA(N0)     &kp RA(DE_SS)   &kp LS(RBKT)  &kp N7      &kp N8         &kp N9         &kp LS(SLASH)  &kp LS(EQUAL)
   &kp LS(N2)    &kp BSLH      &kp LS(N4)    &kp LS(N8)     &kp LS(N9)     &kp LS(N7)      &kp LS(N0)    &kp N4      &kp N5         &kp N6         &kp RBKT       &kp LS(BSLH)
   &trans        &kp LS(N5)    &kp LS(N6)    &kp RA(N8)     &kp RA(N9)     &kp RA(NUBS)    &kp N0        &kp N1      &kp N2         &kp N3         &kp SLASH      &kp EQUAL
                                             &kp NUBS       &kp LS(NUBS)   &trans          &trans        &trans      &kp RA(E)
            >;
        };

        layer_4 {
            bindings = <
   &trans        &trans        &trans        &trans         &trans         &trans          &trans     &trans         &trans         &trans         &trans         &bootloader
   &trans        &trans        &trans        &trans         &trans         &trans          &kp LEFT   &kp DOWN       &kp UP         &kp RIGHT      &trans         &trans
   &trans        &trans        &trans        &trans         &trans         &trans          &trans     &kp C_PREV     &kp C_PP       &kp C_NEXT     &trans         &trans
                                             &trans         &trans         &trans          &trans     &kp C_MUTE     &kp C_VOL_DN
            >;
        };

        layer_5 {
            bindings = <
   &trans        &trans        &trans        &trans         &trans         &trans          &trans     &trans         &trans         &trans         &trans         &bootloader
   &trans        &trans        &trans        &trans         &trans         &trans          &trans     &trans         &trans         &trans         &trans         &trans
   &trans        &trans        &trans        &trans         &trans         &trans          &trans     &trans         &trans         &trans         &trans         &trans
                                             &trans         &trans         &trans          &trans     &trans         &trans
            >;
        };

        layer_6 {
            bindings = <
   &trans        &trans        &trans        &trans         &trans         &trans          &trans     &kp F7         &kp F8         &kp F9         &kp F10        &trans
   &trans        &trans        &trans        &trans         &trans         &trans          &trans     &kp F4         &kp F5         &kp F6         &kp F11        &trans
   &trans        &trans        &trans        &trans         &trans         &trans          &trans     &kp F1         &kp F2         &kp F3         &kp F12        &trans
                                             &trans         &trans         &trans          &trans     &trans         &trans
            >;
        };

        layer_7 {
            bindings = <
   &kp TAB       &kp Q         &kp W         &kp E          &kp R          &kp T           &trans     &trans         &trans         &trans         &trans         &trans
   &kp CAPS      &kp A         &kp S         &kp D          &kp F          &kp G           &trans     &trans         &trans         &trans         &trans         &trans
   &kp LSHFT     &kp Z         &kp X         &kp C          &kp V          &kp B           &trans     &trans         &trans         &trans         &trans         &kp RSHFT
                                             &kp LCTRL      &kp LALT       &kp SPACE       &trans     &trans         &trans
            >;
        };

        layer_8 {
            bindings = <
   &trans        &kp Q         &kp W         &kp E          &kp R          &kp T           &kp DE_Z   &kp U          &kp I          &kp O          &kp P          &kp DE_UE
   &trans        &kp A         &kp S         &kp D          &kp F          &kp G           &kp H      &kp J          &kp K          &kp L          &kp DE_OE      &kp DE_AE
   &trans        &kp DE_Y      &kp X         &kp C          &kp V          &kp B           &kp N      &kp M          &kp COMMA      &kp DOT        &kp SLASH      &trans
                                             &trans         &trans         &trans          &trans     &trans         &trans
            >;
        };
    };
};
